# ====================================================
# Environment Variables for Docker & Coolify
# ====================================================

# Laravel Application
APP_NAME=QuranVideoMaker
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:1itc9RJje9/S2e0Hgsr9IfChEy1gfTyvyQkmq6omAAM=
APP_URL=https://api.yourdomain.com

# Database Settings
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=quran_video_maker
DB_USERNAME=quran_user
DB_PASSWORD=choose_a_strong_password_here
DB_ROOT_PASSWORD=choose_a_strong_root_password_here

# Queue & Storage
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=3600
FILESYSTEM_DISK=local

# FFmpeg and Quran Paths
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
QURAN_STORAGE_PATH=/var/www/html/storage/quran-video-data

# Next.js Frontend
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
